; ACME 0.96.4
; 
; [binary MAX Size: (16+12)*256 = 7168 bytes]
;
; UNREEEAL SUPERHERO 3 TRIBUTE 
; GROUiK / FRENCH TOUCH
; 01/2020
;
; v0.08 - Release version
;
!cpu 6502
!convtab "a2txt.bin" ; 
!sl "lbl_main.txt"

; INCLUDE
!source "lbl_pts.txt"
!source "lbl_sub.txt"

           *= $D000 ; ORG = $D000 (RAM Langage Card)

; =====================================
VERTBLANK   = $C019
FLOAD       = $FC00     ; routine Fast Load XTREME - MAIN
; =====================================
; PAGE ZERO
bRefresh    = $01   ; byte REFRESH RATE ($00/50Hz | $01/60Hz)
bSLOT       = $02   ; numero SLOT * 0x10
IntL        = $03   ; L value for INT delay
IntH        = $04   ; H value for INT delay

; FAST LOAD
PISDEP      = $0A   ; PISTE DE DEPART
SECDEP      = $0B   ; SECTEUR DE DEPART
BUFFER      = $0C   ; Buffer LOW+HIGH ; + $0D
TOTSEC      = $0E   ; TOTAL DES SECTEURS A CHARGER
CURTRK1     = $0F   ; piste de d�part DRIVE 1 - A INITIALISER A ZERO pour le premier appel !

save_A      = $30
save_X      = $31
save_Y      = $32

Tick        = $3D   ; +$3E

; -------------------------------------
z80_A       = $70
z80_C       = $71
z80_B       = $72
z80_E       = $73
z80_D       = $74
z80_L       = $75
z80_H       = $76
z80_IX      = $77       ; +$78
z80_IY      = $79       ; +$7A
z80_AP      = $7B
val1        = $7C       ; +$7D
val2        = $7E       ; +$7F
; -------------------------------------
cSwap       = $90
bAnimK7     = $91
cAnimK7     = $92
; =============================================================================
MAIN
!zone
; Chargement PLAYER + PT3
            STA $C000           ; 80STOREOFF
            STA $C008           ; zero Page = Main (+ $FXXX MAIN)
        
            LDA #$00            ; secteur
            STA SECDEP
            LDA #$02
            STA PISDEP          ; piste 
            LDA #$80            ; chargement
            STA BUFFER+1        
            LDA #$00
            STA BUFFER
            LDA #56
            STA TOTSEC      
            JSR FLOAD           ; chargement rapide

; Chargement HIRES x2 + SUB
            LDA #$06
            STA PISDEP          ; piste 
            LDA #$20            ; chargement
            STA BUFFER+1        
            LDA #64+6
            STA TOTSEC      
            JSR FLOAD           ; chargement rapide
; Some inits
            LDA #<(TextScroll-1)
            STA iText
            LDA #>(TextScroll-1)
            STA iText+1
            LDA #00
            STA CountScroll
            STA cSpace
            STA sScroll
            STA cSwap
            STA cDisplayFreq
            STA bAnimK7 
            LDA TextScroll
            STA nextchar
            LDA #15
            STA cAnimK7
            
            ; ERASE LORES2
            LDX #04
            LDA #00
            TAY
.l1         STA $800,Y
            DEY
            BNE .l1
            INC .l1+2
            DEX
            BNE .l1
            ; change mode (clean way -> wait for next VBL)
-           LDA VERTBLANK         
            BPL -                                                        
-           LDA VERTBLANK         
            BMI -

            LDA $C050
            LDA $C055
            LDA $C056

            ; set LORES data
            LDX #39
-           LDA LORES,X
            STA $428,X
            LDA LORES+40,X
            STA $4A8,X
            LDA LORES+80,X
            STA $528,X
            DEX
            BPL -
            ; set Text data
            LDA #$20
            STA $750
            STA $750+39
; =============================================================================
Init_MB     ; init Mockingboard             
!zone
            ; init MB (6522/AY1) / (6522/AY2)
            LDA #$FF
            STA $C403          ; DDRA1
            STA $C483
            ; second MB
            STA $C503
            STA $C583
            ; ---------
            LDA #$07
            STA $C402          ; DDRB1
            STA $C482
            ; second MB
            STA $C502
            STA $C582
            ; ---------

            ; clean REGISTER AY1 / AY2
            LDA #$00
            STA $C400
            STA $C480
            ; second MB
            STA $C500
            STA $C580
            ; ---------
            LDA #$04
            STA $C400
            STA $C480
            ; second MB
            STA $C500
            STA $C580
            ; ---------
; -------------------------------------
; init Player PT3
            JSR INIT
; -------------------------------------
Init_INT    ; init interrupt
!zone       
            ; pour IIe 
            LDA #<INT_ROUT1
            STA $FFFE       
            LDA #>INT_ROUT1
            STA $FFFF
 
            SEI                 ; inhib
        
            ; préparation interruption - TIMER 1 6522 
            LDA #%01000000      ; continuous interrupt / PB7 disabled
            STA $C40B         ; Auxiliary Control Register

            LDA #%11000000      ; 
            STA $C40D           ; interrupt flag register   (Time Out of Timer 1/Int)
            STA $C40E           ; interrupt Enable register (Timer 1 + Set)
; =================================================================================================
!align 255,00       ; align here to avoid syncloop crossing page 
            ; PRECISE VBL detection - PAL/NTSC
SYNC
-           LDA VERTBLANK         
            BMI -                       ; wait fin display courant                                            
-           LDA VERTBLANK         
            BPL -                       ; wait fin VBL courant 

            ; Debut DISPLAY     
            LDA $EA                     ; 3

           ; 20279
-           LDY #255
            JSR WAIT65                  ; 255*65 = 16575
            LDY bRefresh                ; 56 (PAL) / 06 (NTSC)
            JSR WAIT65ZP                ; 56*65 = 3640 (PAL)
                                        ; = 20215

            LDY #00
            JSR WAIT57                  ; 57

            LDA VERTBLANK               ; 4 (lecture au 4ème cycle)
            BMI -                       ; 3
                                        ; = 20215+57+4+3 = 20279
            
            ; ici synchro précise => DEBUT DISPLAY
; -----------------------------------------------------------------
; WARNING: DISPLAY detected (VERTBLANK <0) from cycle #52 of last line (#311) of VBL
; so BMI not taken (LDA VERTBLANK occurs at cycle #51 of line 311)
                                                                            ; 2 cycles already passed during DISPLAY (bmi not taken)          
; line 311 / cycle 54
;                                       
            NOP : NOP : NOP : NOP  : LDA $EA                                ; +11     
;                                                                           ; = 65
; line 0 (display) / cycle 0

            ; on doit attendre 191+70+50=311 lignes pour revenir cycle 0 dernière ligne VBL (ou 261 si NTSC)
            LDY #255
            JSR WAIT65
            LDY bRefresh                 ; 255+56=311 (PAL) / 255+06=261 (NTSC)
            JSR WAIT65ZP
; =================================================================================================          
            ; ici synchro précise => dernière ligne VBL cycle 0
            ; WAIT 53 cycles
            ; -7 => 6502 INT Sequence
            ; -2 => min cycles executed by opcode before INT 
            ; -3 => INT routine first instruction before mode changement [save_A]
            ; = 41 cycles here
            ; so INT_ROUT1 will begin at the RIGHT HBL of the last VBL line (actually real beginning of display)

            STA $C054                                                       ; 4
            STA $C052                                                       ; 4               
            STA $C050           ; gfx                                       ; 4
            STA $C057           ; hires                                     ; 4

            STA $C010           ; keyboard strobe                           ; 4

            LDA #$00                                                        ; 2
            STA Tick                                                        ; 3
            STA Tick+1                                                      ; 3

            LDX IntL                                                        ; 3
            LDY IntH                                                        ; 3           
            STX $C404                   ; T1C_1-Lower                       ; 4
            STY $C405                   ; T1C_1-High                        ; 4 (counter launched at the last cycle of STY)
                                        ; -> writing launch countdown       ; = 42
; =================================================================================================
            CLI
LOOP        NOP : NOP : NOP : NOP : NOP : NOP : NOP : NOP : NOP : NOP : NOP ; needed!
            LDA Tick+1
            CMP #>(FRAMEMAX+1) ; +1 to check if loop enable or not
            BNE LOOP
            LDA Tick
            CMP #<(FRAMEMAX+1)
            BNE LOOP

            ; end... MUTE / black screen
            JSR MUTE
            LDA $C056
            LDA $C055
            LDA #%01000000
STOPINT     STA $C40E           ; $CX0E => VIA_IER
END         JMP END
; =============================================================================
INT_ROUT1
!zone
;DELAY = 25                  ; value FOR AIPC (to compensate timing issue)
DELAY = 24                  ; value FOR APPLEWIN / REAL APPLE II
TIMER2 = 8*8*65-DELAY
		    STA save_A                                                      
            ; redefine timer
            SEC
            LDA #<TIMER2                                                             
            SBC IntL
            STA IntL
            LDA #>TIMER2
            SBC IntH
            STA IntH
            CLC
            LDA IntL                                                   
            ADC $C404           ; + clear interrupt                 ; 4                   
            STA $C404                                               ; 4
            STA IntL                                                ; 3       
            LDA IntH                                                ; 3      
            ADC $C405                                               ; 4
            STA IntH                                                ; 3   
            STA $C405           ; + launch timer                    ; 4 = 25   
                          
            ; redefine INT                  
            LDA #<INT_ROUT2
            STA $FFFE       
            LDA #>INT_ROUT2
            STA $FFFF
            CLI                 ; allow INT again!

            JSR PLAY            ; music! (one tick)                         
            ; frame counter
            INC Tick                                                                            
            BNE +                                                                               
            INC Tick+1                                                                          
+
		    LDA save_A			; on récup A
		    RTI					; sortie INT
; =============================================================================
INT_ROUT2
TIMER3 = 3*8*65-DELAY
            STA save_A                                                      
            STA $C056           ; LORES                                     
            STA $C054           ; PAGE1                                     

            ; redefine timer
            SEC
            LDA #<TIMER3                                                             
            SBC IntL
            STA IntL
            LDA #>TIMER3
            SBC IntH
            STA IntH
            CLC
            LDA IntL                                                   
            ADC $C404           ; + clear interrupt                 ; 4                   
            STA $C404                                               ; 4
            STA IntL                                                ; 3       
            LDA IntH                                                ; 3      
            ADC $C405                                               ; 4
            STA IntH                                                ; 3   
            STA $C405           ; + launch timer                    ; 4 = 25                                     

            ; redefine INT                  
            LDA #<INT_ROUT3
            STA $FFFE       
            LDA #>INT_ROUT3
            STA $FFFF

            LDA save_A
            RTI
; =============================================================================
INT_ROUT3
TIMER4 = 11*8*65-DELAY
            STA save_A
            STA $C057           ; HIRES
MODPAGE     STA $C054           ; page X
              
           ; redefine timer
            SEC
            LDA #<TIMER4                                                             
            SBC IntL
            STA IntL
            LDA #>TIMER4
            SBC IntH
            STA IntH
            CLC
            LDA IntL                                                   
            ADC $C404           ; + clear interrupt                 ; 4                   
            STA $C404                                               ; 4
            STA IntL                                                ; 3       
            LDA IntH                                                ; 3      
            ADC $C405                                               ; 4
            STA IntH                                                ; 3   
            STA $C405           ; + launch timer                    ; 4 = 25                                     

            ; redefine INT                  
            LDA #<INT_ROUT4
            STA $FFFE       
            LDA #>INT_ROUT4
            STA $FFFF

            LDA save_A
            RTI
; =============================================================================
INT_ROUT4
TIMER5 = 1*8*65-DELAY
            STA save_A
            STA $C051           ; Text
            STA $C054           ; page1

            ; redefine timer
            SEC
            LDA #<TIMER5                                                             
            SBC IntL
            STA IntL
            LDA #>TIMER5
            SBC IntH
            STA IntH
            CLC
            LDA IntL                                                   
            ADC $C404           ; + clear interrupt                 ; 4                   
            STA $C404                                               ; 4
            STA IntL                                                ; 3       
            LDA IntH                                                ; 3      
            ADC $C405                                               ; 4
            STA IntH                                                ; 3   
            STA $C405           ; + launch timer                    ; 4 = 25                                

            ; redefine INT                  
            LDA #<INT_ROUT5
            STA $FFFE       
            LDA #>INT_ROUT5
            STA $FFFF

            LDA save_A
            RTI
; =============================================================================
INT_ROUT5
TIMER1 = 120*65+1*8*65 - DELAY
            STA save_A
            STA $C050           ; GFX
            STA $C054           ; page1
            
            ; redefine timer
            SEC
            LDA #<TIMER1                                                             
            SBC IntL
            STA IntL
            LDA #>TIMER1
            SBC IntH
            STA IntH
            CLC
            LDA IntL                                                   
            ADC $C404           ; + clear interrupt                 ; 4                   
            STA $C404                                               ; 4
            STA IntL                                                ; 3       
            LDA IntH                                                ; 3      
            ADC $C405                                               ; 4
            STA IntH                                                ; 3   
            STA $C405           ; + launch timer                    ; 4 = 25                              

            ; redefine INT                  
            LDA #<INT_ROUT1
            STA $FFFE       
            LDA #>INT_ROUT1
            STA $FFFF

            STX save_X
            STY save_Y
            ; -------------------------
            ; ANIMATIONS 
            JSR DIS_FREQ
            JSR SCROLLTEXT
            ; -------------------------
            ; SWAP PAGE ANIM  
            LDA cSwap
            BNE .next           ; already in progress
            ; check AY1/Tone Channel B only (related to THIS PT3)
            LDA V1AYREGS+09     ; volume b
            CMP #$0C
            BCC .shunt
            LDA #3
            STA cSwap
            LDA #$55           
            BNE +               ; always
            ; swap
.next       DEC cSwap
            BNE .shunt          ; end of swap ?
            LDA #$54            ; yes: restore page1
+           STA MODPAGE+1       ; set page
            ; -----------
            JMP .fd             ; force display anime K7, same anim/other page
.shunt      ; -------------------------
            ; ANIM K7
            DEC cAnimK7
            BNE .end
            LDA #15
            STA cAnimK7
            LDA bAnimK7         ; change boolean
            EOR #01
            STA bAnimK7
.fd         LDA MODPAGE+1
            CMP #$54
            BEQ .animP1
            ; anim P2
            LDA bAnimK7
            BEQ +
            JSR ANIM_1P2
            JMP .end
+           JSR ANIM_2P2
            JMP .end
            ; anim P1
.animP1     LDA bAnimK7
            BEQ +
            JSR ANIM_1P1
            JMP .end
+           JSR ANIM_2P1
            ; -------------------------
.end        LDA save_A
            LDX save_X
            LDY save_Y
            RTI
; =============================================================================
!align 255,0
WAIT65              ; = attend Y * 65 cycles exactement (JSR/RTS compris -> APPEL EN 8 cycles obligatoire -> LDY #xx / JSR WAIT65)
WAIT65ZP = * + 1    ; = attend Y * 65 cycles exactement (JSR/RTS compris -> APPEL EN 9 cycles obligatoire -> LDY ZP / JSR WAIT65Z)
!zone           
		    LDA $EA     ; 3 (dummy)  -> on arrive sur NOP si JSR WAIT65Z
WAIT62      ; = attend 1*62 cycles exactement (JSR/RTS compris -> LDY #01 / JSR WAIT63)
            DEY			; 2					
		    BEQ .S1	    ; 3/2			
                  
.WL1 	    LDX #$0B				            
.WL2 	    DEX							
		    BNE .WL2	; 2 + (2+3)*10 + 2 + 2 = 56															
                      
		    NOP			; 2					
		    NOP			; 2					
		    DEY			; 2					
		    BNE .WL1	; (56+2+2+2+3)*(Y-2) + 56 + 2 + 2 + 2 + 2 = 65*Y - 2*65 + 64 = 65*Y - 66				

WAIT59      ; = attend 1*59 cycles exactement (JSR/RTS compris -> LDY #xx / JSR WAIT59)											                      
		    LDX #$08					
.WL3 	    DEX							
		    BNE .WL3	; 2 + (2+3)*7 + 2 + 2 = 41					
                							
		    NOP			; 2					
		    NOP			; 2					
		    RTS			; 6

                        ; WAIT62 = 2 + 2 + (65-66) + 41 + 2 + 2 + 6 + (8) = 62 
                        ; WAIT65 = 3 + 2 + 2 + (65*Y-66) + 41 + 2 + 2 + 6 + (8) = 65*Y
                        ; WAIT59 = 41 + 2 + 2 + 6 + (8) = 59 					

WAIT57      ; = attend 1*57 cycles exactement (JSR/RTS compris -> LDY #xx / JSR WAIT57)											         
.S1	 	    NOP         ; 2
WAIT55      ; = attend 1*55 cycles exactement (JSR/RTS compris -> LDY #xx / JSR WAIT55)	
            LDX #08					
                      
.WL4 	    DEX							
		    BNE .WL4    ; 2 + (2+3)*7 + 2 + 2 = 41					
		    RTS         ; 6
                        ; = 49

                        ; WAIT65 = 3 + 2 + 3 + 49 + (8) = 65
                        ; WAIT62 = 2 + 3 + 49 + (8) = 62
                        ; WAIT57 = 49 + (8) = 57
                        ; WAIT55 = 47 + (8) = 55
; =============================================================================
LORES
!binary "lores.bin"
ENDMAIN