		LDA $C055		; 4
		LDX #3
.bw		DEX
		BNE .bw			; 16
		NOP				; 2
		JMP WAITHBL		; 3			
; -----------------------------
SPLIT2X16		; 40
!zone
		LDA $C054		; 4
		INC Temp0		; 6
		INC Temp0		; 6
		LDA $C055		; 4
		INC Temp0		; 6
		INC Temp0		; 6
		INC Temp		; 5
