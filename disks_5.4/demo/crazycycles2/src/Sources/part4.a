		LDA $C054		; 4
		INC Temp0		; 6
		INC Temp		; 5
		LDA Temp		; 3
		LDA $C055		; 4
		INC Temp0		; 6
		INC Temp0		; 6
		LDA Temp		; 3
		JMP WAITHBL		; 3	
