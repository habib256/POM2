!zone
		LDA $C054		; 4
		INC Temp0		; 6
		NOP
		NOP				; 4
		LDA $C055		; 4
		LDX #3
.bw		DEX
		BNE .bw			; 16
		LDA Temp		; 3
		JMP WAITHBL		; 3		
; -----------------------------
SPLIT2X15		; 40
!zone
		LDA $C054		; 4
		INC Temp0		; 6
