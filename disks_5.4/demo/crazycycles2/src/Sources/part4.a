		JSR P3  ; 21
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3  ; 22
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3  ; 23
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3  ; 24
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3  ; 25
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		
		JSR P4  ; 26
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4  ; 27
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4  ; 28
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4  ; 29
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4  ; 30
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4  ; 31
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4  ; 32
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		JSR P4
		
		INC Temp0			; 6
		INC Temp0			; 6
		LDA Temp			; 3

		JMP BP				; 3
; =============================================================================
P1		JMP (Partie1)  ; 5 [si 6502/65816 ou 6 si 65C02]
P2		JMP (Partie2)
P3		JMP (Partie3)
P4		JMP (Partie4)
; =============================================================================				
Temp0		!byte 0
; =============================================================================
!align 255,0
WAITHBL ; arrivé ici on a : 6 + 5 + 40 = 51
!zone
		LDA b65C02		; 3
		BEQ .s1			; 3 [si 6502/65816 ou 2 si 65C02]
.s1		NOP 			; 2		
		RTS				; 6
						; = 14
; -----------------------------
SPLIT2X04		; 40
!zone
		LDA $C054		; 4
		LDA $C055		; 4
		LDX #5
.bw		DEX
		BNE .bw			; 26
		LDA Temp		; 3
		JMP WAITHBL		; 3	
; -----------------------------
SPLIT2X05		; 40
!zone
		STA $C054,X		; 5			!! X = 0 impératif
		LDA $C055		; 4
		LDX #5
.bw		DEX
		BNE .bw			; 26
		NOP				; 2
		JMP WAITHBL		; 3
; -----------------------------
SPLIT2X06		; 40
!zone
		LDA $C054		; 4
		NOP				; 2
		LDA $C055		; 4
		LDX #4
.bw		DEX
		BNE .bw			; 21
		INC Temp0		; 6
		JMP WAITHBL		; 3
; -----------------------------
SPLIT2X07		; 40
!zone
		LDA $C054		; 4
		LDA Temp		; 3
		LDA $C055		; 4
		LDX #4
.bw		DEX
		BNE .bw			; 21
		INC Temp		; 5
		JMP WAITHBL		; 3	
; -----------------------------
SPLIT2X08		; 40
!zone
		LDA $C054		; 4
		NOP				; 2
		NOP				; 2
		LDA $C055		; 4
		LDX #4
.bw		DEX
		BNE .bw			; 21
		NOP
		NOP				; 4
		JMP WAITHBL		; 3
; -----------------------------
SPLIT2X09		; 40
!zone
		LDA $C054		; 4
		INC Temp		; 5
		LDA $C055		; 4
		LDX #4
.bw		DEX
		BNE .bw			; 21
		LDA Temp		; 3
		JMP WAITHBL		; 3	
; -----------------------------
SPLIT2X10		; 40
!zone
		STA $C054,X		; 5
		INC Temp		; 5
		LDA $C055		; 4
		LDX #4
.bw		DEX
		BNE .bw			; 21
		NOP				; 2
		JMP WAITHBL		; 3			
; -----------------------------
SPLIT2X11		; 40
!zone
		STA $C054,X		; 5
		INC Temp0		; 6
		LDA $C055		; 4
		LDX #3
.bw		DEX
		BNE .bw			; 16
		INC Temp0		; 6
		JMP WAITHBL		; 3		
; -----------------------------
SPLIT2X12		; 40
!zone
		LDA $C054		; 4
		INC Temp0		; 6
		NOP				; 2
		LDA $C055		; 4
		LDX #3
.bw		DEX
		BNE .bw			; 16
		INC Temp		; 5
		JMP WAITHBL		; 3		
; -----------------------------
SPLIT2X13		; 40
!zone
		LDA $C054		; 4
		INC Temp0		; 6
		LDA Temp		; 3
		LDA $C055		; 4
		LDX #3
.bw		DEX
		BNE .bw			; 16
		NOP
		NOP				; 4
		JMP WAITHBL		; 3
