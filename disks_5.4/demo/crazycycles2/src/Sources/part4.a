;@com.wudsn.ide.asm.hardware=APPLE2 
; ACME 0.90
; CRAZY CYCLES 2
; PART IV

; version 0.01



!sl "part4label.a"		; sauvegarde labels (debug)
!source "../main/mainlabel.a"

		*= $6000 		; ORG = $6000

; CONSTANTES PROGRAMME =================

; CONSTANTES SYSTEME ===================
VERTBLANK	 	= $C019	; 
; Page ZERO ============================

bMachine 		= $0A	; byte MACHINE ($7F/IIE | $FF/GS)
bRefresh		= $0B	; refresh rate : type NTSC/60Hz - PAL/50Hz (00 = 50HZ | 01 = 60 HZ)
b65C02			= $0C	; 01 si 65C02 / 00 sinon *** NOTE : JMP (p0) sur 65C02 = 6 cycles / 5 cycles sur 6502/65816

OUT1			= $20 ; +$21
OUT2			= $22 ; +$23
	
Mark			= $25
MarkCounter		= $26
; --------------------------------------
LIGNE			= $40
HAUTEUR			= $41

Partie1			= $45  	; + $46
Partie2			= $47	; + $48
Partie3			= $49	; + $4A
Partie4			= $4B	; + $4C
IndexP1			= $4D
IndexP2			= $4E
IndexP3			= $4F
IndexP4			= $50
; =============================================================================

; -----------------------------------------------------------------------------
PARTIV
!zone	
		LDA	 bMachine 	;
.lp1	CMP VERTBLANK 
		Bpl   .lp1		; on attend la fin du VBL courant

		LDA  bMachine	; 3
.lp2	CMP VERTBLANK	; 4
		Bmi   .lp2	 	; 2 => on attend la fin du display courant/début du VBL	
; =============================================================================
; INIT
			
			LDA #00   	
			STA LIGNE 	; on démarre à 01
			STA Mark
			STA IndexP1
			LDA #64
			STA IndexP2
			LDA #128
			STA IndexP3
			LDA #192
			STA IndexP4      
			LDA #189 	; on démarre à 187             
			STA HAUTEUR
			
			
;  -- détection 65C02 -- 		
			LDA bMachine
			BMI .suiteGS 		; on a un GS donc on s'occupe pas du 65C02

			!byte $80,$03		; BRA +3 si 65C02 ou DOP si 6502
			JMP .suite6502		; si le BRA passe par dessus, on a un 65C02, sinon le DOP nous amène au JMP
			; si on arrive ici, 65C02
			LDA #01
			JMP .suite
.suiteGS
.suite6502	LDA #00
.suite		STA b65C02
; -- --------------- --		
			
; =============================================================================
; ** [VBL] **

						
			LDA	 bMachine 	;
.lp3		CMP VERTBLANK 
			Bpl   .lp3		; on attend la fin du VBL courant
; =============================================================================
; ** [DIPLAY] **

!zone
; recherche synchronisation - dernière ligne LORES/TXT
		
.LS1	LDA $C070		; lecture pos $02  ** important
		CMP #$0C		; 
		BNE .LS1
		NOP
		NOP
		NOP
		NOP
		NOP				;
		LDA $C070		; lecture pos $14 ** important
		CMP #$02			
		BNE .LS1
		NOP
		NOP
		NOP
		NOP
		NOP	
		LDA $C070		; 4 ;lecture pos $26 ** important
 		CMP	#$0C		; 2
		BNE .LS1    	; 2 = 8

		; début synchro 
		; on attend 65 cycles - 08 déjà effectués = 57 pour retrouver le byte en $7D0+$26 (nouvelle ligne sur les 8)

		LDA Temp		; 3

.LS2	; 11 cycles déjà faits ici sur les 65
		LDX #$0A
.WL1	DEX	
		BNE .WL1		; 51 cycles  

		LDA Temp		; 3
						; = (8 + 3) + 51 + 3 = 65
				
		LDA $C070		; 4		; lecture des "autres lignes" en $7F6
		CMP #$0C		; 2
		BNE .S2			; 2/3
		JMP .LS2		; 3  
						; = 11 ; on boucle tant qu'on trouve $00 à cette position

.S2		; quand on arrive ici, on est position $26 de la première ligne de VBL
		; on "revient" au début de la seconde ligne
		; (4-2) + 2 + 3 = 7 cycles déjà effectué en "HBL" de la première ligne de VBL
		; 25-7 = 18

		; >>>>>>>>>>>>
		; WARNING : il faudrait 18 cycles d'attente en théorie

		LDA Temp		; 3
		LDA Temp		; 3
		INC Temp		; 5
		NOP				; 2 
						; = 13 (empiriquement)
		; <<<<<<<<<<<<

; on arrive début seconde ligne de VBL
; --------------------------------------------
; suivant PAL OU NTSC
; 1 ligne VBL (NTSC) ou 1 + 50 ligne VBL (PAL)
		LDA bRefresh	; 3
		BNE .NTSC		; 3 / (2)
		
		NOP
		NOP			; 3 (appel routine WAIT) + 1 (compenser BNE non pris)
		LDY #50
		JSR WAIT 	; 50 * 65 (PAL)

.NTSC	; 65 - 6 cycles = 59
		LDX #11
.BW0	DEX
		BNE .BW0 ; 56
		LDA Temp ; 3 
; --------------------------------------------
; début 3ème ligne de VBL
		LDA Temp
		LDY #67 		; 70 - 3 ; [ 2 lignes de VBL déjà effectuées + 1 ligne de VBL à ne pas faire ]
		JSR WAIT
; on est maintenant début dernière ligne de VBL
; =============================================================================
TRANS					; transition VBL entre DGR (80col) et HIRES (40 col)
!zone 
; premier octet dernière ligne de VBL                               
		LDA Temp		; 3 (pour compenser le JMP)
.BP
		INC LIGNE		; 5
		LDA LIGNE		; 3
		CMP #95         ; 2
		BEQ .FIN        ; 2      
		DEC HAUTEUR     ; 5     
		DEC HAUTEUR     ; 5 = 25 cycles (JMP de la boucle inclus)     
 		
 
		LDX #7									                        
.WL0	DEX									
		BNE .WL0 		; 6*5 + 6 = 36
		NOP
		NOP				; + 2 = 40                    
                    
; ** [DISPLAY] **
; === phase 1 ; 

		; 1 ligne (65 cycles) -->
		STA $C057 		; 4		HGR
		STA $C00C		; 4		80 colonnes OFF
		STA $C05F		; 4		SETAN3 ON / DHGR
			
		NOP				; 2                   
		LDX #10									                        
.WL1	DEX									
		BNE .WL1 		; 9*5 + 6 = 51	
		; <---------

		LDY LIGNE ;
		NOP					
		JSR WAIT  
		
; === phase 2
		; 1 ligne -->
		STA $C056		; 4		GR
		STA $C00D		; 4		80 colonnes ON
		STA $C05E		; 4		SETAN3 OFF / DGR
                         
		NOP				; 2
		LDX #10							               
.WL2 	DEX									
		BNE .WL2 		; 9*5 + 6 = 51 							
		; <--
		
        LDY HAUTEUR						
		NOP
		JSR WAIT
		
; === phase 3
		; 1 ligne (65 cycles) -->
		STA $C057 		; 4		HGR
		STA $C00C		; 4		80 colonnes OFF
		STA $C05F		; 4		SETAN3 ON / DHGR
			
		NOP				; 2                   
		LDX #10									                        
.WL3	DEX									
		BNE .WL3 		; 9*5 + 6 = 51	
		; <---------

		LDY LIGNE ;
		NOP					
		JSR WAIT  
; ===                    
; *** [VBL] ***
; --------------------------------------------
; suivant PAL OU NTSC
; 1 ligne VBL (NTSC) ou 1 + 50 ligne VBL (PAL)
		LDA bRefresh	; 3
		BNE .NTSC		; 3 / (2)
		
		NOP
		NOP			; 3 (appel routine WAIT) + 1 (compensé BNE non pris)
		LDY #50
		JSR WAIT 	; 50 * 65 (PAL)

.NTSC	; 65 - 6 cycles = 59
		LDX #11
.BW0	DEX
		BNE .BW0 ; 56
		LDA Temp ; 3 
; --------------------------------------------
; début 2ème ligne de VBL
		LDA Temp
		LDY #68 		; 70 - 2 ; [ 1 ligne de VBL déjà effectuée + 1 ligne de VBL à ne pas faire]
		JSR WAIT
				
		JMP .BP								
                         
.FIN
; arrivée ici = 14 cycles dernière ligne de VBL
;
		LDX #10
.WL4	DEX
		BNE .WL4 ; + 51 = 65 ! = 1 ligne de VBL
; --------------------------------------------
; ** [DISPLAY] **   ; 192*65 = 12480

		LDA Temp	
		LDY #(192)
		JSR WAIT		; 1 display complet pour 'rien'... 

; ** [VBL] **
; =============================================================================		
; PLAYER YM
		LDA Temp		; 3 (on compense le JMP BP)
BP
!zone	
; début première ligne de VBL
		
		ROL $C062		; bouton 2 ?			; 6
		bcs .end		; si bouton 2			; 2
		ROL $C061		; bouton 1 ?			; 6
		bcs .end		; si bouton 1			; 2 = 16

		INC Temp
		INC Temp
		NOP
		NOP				; 14 + 16 = 30

		JSR PLAYERYM	; 6 + 1001 = 1007 = 15*65 [+ 32] 
						; 3 + 30 + 32 + 15*65 => 16 lignes !
	
; -----------------------------------------------------------
; => ici 16 lignes de VBL effectuées

		; 1 ligne VBL (NTSC) ou 1 + 50 ligne VBL (PAL)
		LDA bRefresh	; 3
		BNE .NTSC		; 3 / (2)
		
		NOP
		NOP			; 3 (appel routine WAIT) + 1 (compensé BNE non pris)
		LDY #50
		JSR WAIT 	; 50 * 65 (PAL)

.NTSC	; 65 - 6 cycles = 59
		LDX #11
.BW0	DEX
		BNE .BW0 ; 56
		LDA Temp ; 3

; -------------------------------------------------------------------
; => ici 17 lignes de VBL effectuées (ou 17 + 50 si PAL)

; on finit le VBL - 2
		LDA Temp
		LDY #(70-17-3) 			; 
		JSR WAIT
		; x= 0 / y=0

; =>  3 * 65 
		LDA Mark				; 3
		BEQ .s1					; 3
		LDA $C054
.end	RTS						; 
.s1		
		LDY IndexP1				; 3
		LDX Sin2,Y				; 4
		LDA TableSplit3L,X		; 4
		STA Partie1				; 3
		LDA TableSplit3H,X		; 4
		STA Partie1+1			; 3
		INC IndexP1				; 5
								; = 26

		LDY IndexP2				; 3
		LDX Sin1,Y				; 4
		LDA TableSplit2L,X		; 4
		STA Partie2				; 3
		LDA TableSplit2H,X		; 4
		STA Partie2+1			; 3
		INC IndexP2				; 5
								; = 26

		LDY IndexP3				; 3
		LDX Sin2,Y				; 4
		LDA TableSplit3L,X		; 4
		STA Partie3				; 3
		LDA TableSplit3H,X		; 4
		STA Partie3+1			; 3
		INC IndexP3				; 5
								; = 26

		LDY IndexP4				; 3
		LDX Sin1,Y				; 4
		LDA TableSplit2L,X		; 4
		STA Partie4				; 3
		LDA TableSplit2H,X		; 4
		STA Partie4+1			; 3
		INC IndexP4				; 5
								; = 26
				
		LDX #13
.bw1	DEX
		BNE .bw1				; = 66
								; 66 + 110 = 176
								; 3*65 = 195
		LDA $C054				; 4

								; manque 15 cycles (pour commencer dans le HBL) !
; <= 3 * 65 cycles
; -------------------------------------------------------------------
; ** [DISPLAY] *** 192*65
		
		; 0-68 = 69 premières lignes
		JSR P1  ; 1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 2
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 3
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 4
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 5
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 6
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 7
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 8
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 9
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 10
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 11
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1
		JSR P1  ; 12
		JSR P1
		
		JSR P2
		JSR P2
		JSR P2
		JSR P2
		JSR P2  ; 13
		JSR P2
		JSR P2
		JSR P2
		JSR P2
		JSR P2
		JSR P2  ; 14
		JSR P2
		JSR P2
		JSR P2
		JSR P2
		JSR P2
		JSR P2  ; 15
		JSR P2
		JSR P2
		JSR P2
		JSR P2
		JSR P2
		JSR P2  ; 16

		JSR P3
		JSR P3		
		JSR P3
		JSR P3
		JSR P3
		JSR P3  ; 17
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3  ; 18
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3  ; 19
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3
		JSR P3  ; 20
		JSR P3
		JSR P3
		JSR P3
		JSR P3
