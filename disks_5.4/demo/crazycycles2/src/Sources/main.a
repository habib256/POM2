;@com.wudsn.ide.asm.hardware=APPLE2 
; ACME 0.90
; CRAZY CYCLES 2
; version 0.05

; 0.05 	= ajout fin
; 0.041 = ajout intro
; 0.03 	= mise en sous routine du chargement des PART (pour gagner de la place)
; 0.02 	= correction PLAYER (ne tenait pas compte offset Markers) 
; 0.01 	= première version TEST

; taille MAXI = 9 secteurs soit 9 * 256 = 2304 octets

; A FAIRE : REORGANISER LE MAIN pour "combler" l'espace généré par !align 255,0

!convtab "a2txt.bin" ; 
!sl "mainlabel.a"

; INCLUDE

	*= $F100 ; ORG = $F100 (RAM Langage Card)

; PSEUDO CATALOG Track/SectorDebut-Track/SectorFin (inclus)

; T00/S00 			: BOOT0	($800) x1
; T00/S01-S09 		: MAIN	($F100) x8
; T00/S0A-S0F		: FLOAD ($FA00) x6

; PART I
; T01/S00 - T01/S03	: SCREEN PART I 	- MAIN 	($0400)	(04)
; T01/S04 - T01/S07 : SCREEN PART I		- AUX	($0400)	(04)
; T01/S08 - T01/S0E : ZIC PART I 		- MAIN	($8000)	(07)
; T02/S00 - T05/S0F : 2 HGRs			- MAIN 	($2000)	(64)
; T06/S00 - T08/S0D : CODE				- MAIN	($6000) (46)

; PART II
; T09/S00 - T09/S03	: SCREEN PART II 	- MAIN 	($0400)	(04)
; T09/S04 - T09/S07 : SCREEN PART II	- AUX	($0400)	(04)
; T09/S08 - T09/S0E : ZIC PART II 		- MAIN	($8000)	(07)
; T0A/S00 - T0B/S0F : HGR				- MAIN 	($2000)	(32)
; T0C/S00 - T0D/S08 : CODE				- MAIN	($4000) (25)

; PART III
; T0E/S00 - T0E/S03	: SCREEN PART III 	- MAIN 	($0400)	(04)
; T0E/S04 - T0E/S07 : SCREEN PART III	- AUX	($0400)	(04)
; T0E/S08 - T0E/S0C : ZIC PART III 		- MAIN	($8000)	(05)
; T0F/S00 - T12/S0F : 2 HGRs			- MAIN 	($2000)	(64)
; T13/S00 - T14/S03 : CODE				- MAIN	($6000) (20)

; PART IV
; T15/S00 - T15/S03	: SCREEN PART IV 	- MAIN 	($0400)	(04)
; T15/S04 - T15/S07 : SCREEN PART IV	- AUX	($0400)	(04)
; T15/S08 - T15/S0F : ZIC PART IV 		- MAIN	($8000)	(08)
; T16/S00 - T19/S0F : 2 HGRs			- MAIN 	($2000)	(64)
; T1A/S00 - T1A/S0D : CODE				- MAIN	($6000) (14)

; CONSTANTES SYSTEME ===================
VERTBLANK	 		= $C019	;

; CONSTANTES PROGRAMME =================
DATADECOMP			= $800		; AUX

; SOUS-ROUTINES BOOT0
EXECFROMBOOT2  		= $857 	; sous routine de détection type APPLE II (utilise ROM)

; SOUS-ROUTINES PROGRAMMES EXTERNES
HYPLOD				= $FA00	; routine Fast Load

PARTI				= $6000
PARTII				= $4000
PARTIII				= $6000
PARTIV				= $6000

;======PARAMETRES DU FAST LOAD
                        ;-PARAMETRES D'ENTREE
PISDEP   =   $30       ;PISTE DE DEPART
SECDEP   =   $31       ;SECTEUR DE DEPART
BUFFER   =   $32       ;ADRESSE OU L'ON CHARGE
TOTSEC   =   $34       ;TOTAL DES SECTEURS A CHARGER
                        
                        ;-PARAMETRES SORTIE
                          ;-PARAMETRES DE SORTIE
ERRNUM   =   $35       ;CODE ERREUR
SECERR   =   $36       ;SECTEUR OU S'EST PRODUIT L'ERREUR (S'IL Y EN A UN!)
PISERR   =   $37       ;PISTE IDEM

; PAGE ZERO ===========================
; adresses fixes
;
; system
bMachine 	= $0A	; byte MACHINE ($7F/IIE | $FF/GS)
bRefresh	= $0B	; byte type NTSC/60Hz - PAL/50Hz (00 = 50HZ | 01 = 60 HZ)

OUT1		= $20 ; +$21
OUT2		= $22 ; +$23

Mark		= $25
; -------------------------------------
LIGNE		= $40
HAUTEUR		= $41
TrackLoad1	= $42
TrackLoad2	= $43
nbSecLoad2	= $44

Temp		= $7F
; -------------------------------------
; adresses P0 réutilisables
;
; décompression LZ4
Tmp			= $F6
token		= $F7 
dest		= $F8	; + $F9
src1		= $FA	; + $FB
src2 		= $FC  	; + $FD
lenL		= $FE 
lenH		= $FF
; -------------------------------------
;	======== DEBUT PROGRAMME =========
START	
 		JMP EXECFROMBOOT2
 		
DEBUT2				
!zone 				 
 		 ; ========= DETECT REFRESH ===========
DETECTREFRESH
!zone
		; detection refresh rate (PAL/NTSC)
		JSR WAITVBL
		; début VBL

.BP		INC COUNTREF	; 6 ; on incrémente le compteur

		LDX #$09		; 							
.WL1 	DEX				; 					
		BNE .WL1 		; = 46 cycles
						; + 6 + 3 + 3 + 4 + 3 = 65 !
		
		LDA bMachine	; 3

		LDA bMachine	; 3
		CMP VERTBLANK	; 4
		Bpl   .BP	 	; 3 => on boucle tant qu'on est en VBL
		
		LDA COUNTREF
		CMP #72			; >= 72 alors 50 HZ (120*65 cycles de VBL)
		BCS .GO3
		
		LDA #01			; 60HZ (VBL = 70x65 cycles)	
		JMP .GO4

.GO3	LDA #00			; 50HZ (VBL = 120x65 cycles)
.GO4	STA bRefresh	

; -------------------------------------
 	
; =============================================================================
INTRO
!zone
; affichage message intro

		JSR WAITVBL

		LDX #11
.b1		LDA Title1,X
		STA $528+14,X
		DEX
		BPL .b1
		
		LDX #15
		JSR WAITIIE
		
		JSR WAITVBL
		
		LDX #11
.b2		LDA Title2,X
		STA $6A8+14,X
		DEX
		BPL .b2
; -----------------------------------------------------------------------------
; effacement PAGE 1 HIRES
		LDX #32
		LDY #00
		LDA #$FF
.bc1	STA $2000,Y
		DEY
		BNE .bc1
		INC .bc1+2
		DEX
		BNE .bc1
		
		LDX #10
		JSR WAITIIE
; -------------------------------------
TRANS_INTRO					; transition VBL entre TEXT et HIRES
!zone 
		LDA #00              
		STA LIGNE           
		LDA #189               
		STA HAUTEUR          
 
        LDA bMachine                                                                   
.L1	 	CMP VERTBLANK         
		BPL .L1 			; attend fin vbl
                         
.BP                 
		LDA bMachine      
.L2 	CMP VERTBLANK        
		BMI .L2 			; attend fin display
                         
		INC LIGNE
		LDA LIGNE
		CMP #95           
		BEQ .SUITE           
		DEC HAUTEUR          
		DEC HAUTEUR          
                   
                     
        LDA bMachine    
.L3 	CMP VERTBLANK		; attend fin VBL		
		BPL .L3 ;
        NOP                 ; + 2 pour compenser si la fin de VBL est détectée "trop tôt" (observation empirique)
; === phase 1            
		STA $C050 ; 1 LIGNE 
                         
		LDA LIGNE		; timing only
		NOP								
		NOP			
                         
		LDX #$09							
                         
.WL1	DEX									
		BNE .WL1 ;							

		LDY LIGNE ;
		NOP					
		JSR WAIT              
; === phase 2            
		STA $C051 ; 1 LIGNE
                         
		LDX #$0C							
                         
.WL2 	DEX									
		BNE .WL2 ;							

        LDY HAUTEUR						
		NOP
		JSR WAIT
		
; === phase 3            
		STA $C050 ; 1 LIGNE	
                         
; ===                    
		JMP .BP
.SUITE								
; -------------------------------------                         
SUITE
!zone	
		LDX #11
.b3		LDA Title3,X
		STA $528+14,X
		DEX
		BPL .b3

		LDX #11
.b4		LDA Title4,X
		STA $6A8+14,X
		DEX
		BPL .b4
; -------------------------------------
		JSR TRANS_INTRO2
		
; effacement2 PAGE 1 HIRES
		LDX #32
		LDY #00
		TYA
.bc1	STA $2000,Y
		DEY
		BNE .bc1
		INC .bc1+2
		DEX
		BNE .bc1
		
		LDX #10
		JSR WAITIIE

; =============================================================================
PARTIE_I
!zone
		JSR WAITVBL

		; on passe en mode HIRES pour le chargement
		LDA $C057
		LDA $C050		
; =============================================================================
; CHARGEMENT PARTIE I

		LDA #$01
		STA TrackLoad1
		LDA #$02
		STA TrackLoad2
		LDA #32+32+46
		STA nbSecLoad2			
		JSR LOADPART	
		 		
.INITMB		
		; PREMIER init MB (OUT1/OUT2)
		LDA   	#$FF
		LDY	  	#$03
		STA 	(OUT2),Y	; STA   $C403		; DDRA1
		LDY 	#$83
		STA 	(OUT2),Y	; STA   $C483		; DDRA2
		LDA   	#$07
		LDY 	#$02
		STA		(OUT2),Y	; STA   $C402		; DDRB1
		LDY 	#$82
		STA		(OUT2),Y	; STA   $C482		; DDRB2

		LDA 	OUT2+1
		STA		OUT1+1		;
		LDA 	#01
		STA 	OUT1

		JSR RESETMOCKIN
		; ---
		; =============================
		JSR PARTI
		LDA $C057
		LDA $C054
		JSR RESETMOCKIN
; =============================================================================	
PARTIE_II
!zone
		LDA #$09
		STA TrackLoad1
		LDA #$0A
		STA TrackLoad2
		LDA #32+25
		STA nbSecLoad2			
		JSR LOADPART					
		JSR RESTOREOFF
		JSR PARTII
		JSR RESETMOCKIN

; =============================================================================	
PARTIE_III
!zone
		LDA #$0E
		STA TrackLoad1
		LDA #$0F
		STA TrackLoad2
		LDA #32+32+20
		STA nbSecLoad2			
		JSR LOADPART			
		JSR RESTOREOFF
		JSR PARTIII
		LDA $C054
		JSR RESETMOCKIN
; =============================================================================	
PARTIE_IV
!zone
		LDA #$15
		STA TrackLoad1
		LDA #$16
		STA TrackLoad2
		LDA #32+32+14
		STA nbSecLoad2			
		JSR LOADPART
		JSR RESTOREOFF
		JSR PARTIV
		LDA $C054			; page1
		JSR RESETMOCKIN
		
		
		; effacement PAGE 1 TEXT
		LDX #4
		LDY #00
		LDA #$A0
.bc1	STA $400,Y
		DEY
		BNE .bc1
		INC .bc1+2
		DEX
		BNE .bc1

		JSR TRANS_INTRO2
		
		JSR WAITVBL
		LDX #39
.be		LDA End,X
		STA $5A8,X
		DEX
		BPL .be
		
		STA $C010
.bk		LDA $C000
		BPL .bk
		
		; reboot !
		LDA #$8D
		STA $300
		LDA #$82
		STA $301
		LDA #$C0
		STA $302
		LDA #$4C
		STA $303
		LDA #$62
		STA $304
		LDA #$FA
		STA $305		
		JMP $300
; =============================================================================
; =============================================================================
; SOUS ROUTINES
; =============================================================================
LOADPART
!zone
; =============================================================================
; CHARGEMENT SCREEN LORES 

		; === CHARGEMENTS =====
		; MAIN
 		LDA #00
		STA SECDEP			; secteur 00
 		STA BUFFER			; buffer low
		LDA #$04			; buffer high -> $400 (MAIN)
		STA BUFFER+1 
		LDA TrackLoad1
		STA PISDEP			; piste départ
		LDA #04				; nb secteurs
		STA TOTSEC		
		JSR HYPLOD			; chargement !

		STA $C000			; 80STOREOFF
		STA $C002			; read MAIN Memory
		STA $C005 			; write AUX Memory
		STA $C008			; zero Page = Main (+ $FXXX MAIN)

		; AUX
		LDA #04
		STA SECDEP			; secteur 04
		LDA #00
 		STA BUFFER			; buffer low
		LDA #$04			; buffer high -> $400 (AUX)
		STA BUFFER+1 
		LDA TrackLoad1
		STA PISDEP			; piste 
		LDA #04				; nb secteurs
		STA TOTSEC		
		JSR HYPLOD			; chargement !
		
		STA $C004			; restore write MAIN Memory

		JSR WAITVBL
		
		STA $C00D			; 80 colonnes
		STA $C05E			; SETAN3 / DHGR
		LDA $C056			; LORES

; =============================================================================
; chargement chargement ZIC
		LDA TrackLoad1
		STA PISDEP			; piste 
 		LDA #08
 		STA SECDEP			; secteur 08
		LDA #00
		STA BUFFER
 		LDA #$80			; buffer -> $8000
		STA BUFFER+1
		LDA #08				; nb secteurs (5, 7 ou 8 - on lit 8 sectors à chaque fois)
		STA TOTSEC		
		JSR HYPLOD			; chargement !

; =============================================================================
; DECOMPRESSION MUSIC
; =============================================================================			
		
		JSR DECOMP
		STA $C004			; restore write MAIN Memory

; =============================================================================			 		
 		; chargement HGR(s) + CODE 
		LDA TrackLoad2
 		STA PISDEP			; piste $02
		LDA #00			
		STA SECDEP			; secteur $00
		LDA #$20			; buffer high
		STA BUFFER+1		
		LDA #$00
		STA BUFFER			; buffer => $2000
		LDA #32+32+47		; nb secteurs => 2*32 (HGRs) + xx (CODE)
		STA TOTSEC		
		JSR HYPLOD			; chargement !
 ; =============================================================================	
		RTS

; -------------------------------------
DECOMP
!zone
; routine de décompression LZ4
; code: XXL and FOX (from Atari Scene)
; modified: FT
;
; dans A - partie haute adresse data compressées
 
; init

		LDA #$80
		STA src2+1					
		LDA #$00					; commence en $00
		STA src2
		LDA #<DATADECOMP
		STA dest
		LDA #>DATADECOMP
		STA dest+1
		
		LDY #0
		STY lenH
		STY lenL	

; init mémoire
		
		STA $C000			; 80STOREOFF
		STA $C002			; read MAIN Memory
		STA $C005 			; write AUX Memory
		STA $C008			; zero Page = Main

; -------------------------------------
; décomp LZ4 routine
; -------------------------------------				
.BP
             		jsr   	.GET_BYTE                  
                  	sta    	token
               		lsr
               		lsr
               		lsr
               		lsr
                  	beq    	.read_offset                     ; there is no literal
                  	cmp    	#$0f
                  	jsr    	.getLength
                  	
.b_literals         jsr    	.GET_BYTE
                  	jsr    	.store
                  	bne    	.b_literals
                  	
.read_offset       	jsr    	.GET_BYTE		; offset L
                  	tax
                  	sec
                  	eor    	#$ff
                  	adc    	dest
                  	sta    	src1
                  	txa
                  	php							
                  	jsr    	.GET_BYTE		; offset H
                  	plp
                  	bne    	.not_done
                  	tax
                  	beq    	.unlz4_done	; sortie routine !
.not_done          	eor    	#$ff
                  	adc    	dest+1				; calcul offset H (absolu)
                  	STA		src1+1				; sauvegarde de l'offset après correction hors page $C0 : $C0->$D0 / $D0->$E0
                  	LDY 	#00					; remise à 0 de Y
                  	; c=1
		            lda    	token
                  	and    	#$0f
                  	adc    	#$03        ; 3+1=4
                  	cmp    	#$13
                  	jsr    	.getLength

.b1                 STA 	$C003			; read AUX Memory
					lda    	(src1),Y
                  	STA 	$C002			; read MAIN Memory
                  	INC 	src1
                  	BNE 	.s1
                  	INC 	src1+1 	
.s1                 jsr    	.store
                  	bne    	.b1
                  	jmp		.BP                  


.store             	sta    	(dest),Y
                  	INC		dest
                  	BEQ 	.s2               	
		            dec    	lenL
                  	beq    	.s2b
.unlz4_done         rts
.s2b                dec    	lenH
		        	rts
.s2					INC 	dest+1
					dec    	lenL
                  	beq    	.s2b
		        	rts
															

.getLength_next    	jsr    	.GET_BYTE
                  	tax
                  	clc
	                adc    	lenL
                  	bcc    	s3
                  	inc    	lenH
s3   	            inx

.getLength         	sta    	lenL
                  	beq    	.getLength_next
                  	tax
                  	beq    	.s4
                  	inc    	lenH
.s4 	            rts
	
.GET_BYTE			LDA		(src2),Y		
					INC 	src2		
					BEQ 	.s5
					RTS					
.s5					INC 	src2+1			
					RTS


; =============================================================================
!align 255,0
PLAYERYM
!zone

		LDA OUT1			; 3 permutation g/d
		EOR #$80			; 2
		STA OUT1			; 3
		LDA OUT2			; 3
		EOR #$80			; 2
		STA OUT2			; 3

		STA $C003			; 4 read AUX Memory
		LDY #00				; 2
							; = 22 cycles

		; all registers NOT COMPRESSED !
		; cycles ==>
		; registre 0
		LDA #00				; 2	registre 0
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$07			; 2	Set fct "Set PSG Reg #"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)
OFFR0
.OFFR0	LDA $800			; 4
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$06			; 2	Set fct "Write DATA"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)
		INC .OFFR0+1		; 6
		BNE .sr1b			; 2/3
		INC .OFFR0+2		; 6
		JMP .sr1			; 3

.sr1b	INC Temp			; 5
		LDA Temp			; 3
		; <== cycles 		; = [67]

.sr1	; registre 1
		LDA #01				; 2	registre 1
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$07			; 2	Set fct "Set PSG Reg #"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)

OFFR1
.OFFR1	LDA $13B8			; 4
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$06			; 2	Set fct "Write DATA"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)
		INC .OFFR1+1		; 6
		BNE .sr2b			; 2/3
		INC .OFFR1+2		; 6
		JMP .sr2			; 3

.sr2b	INC Temp			; 5
		LDA Temp			; 3 

.sr2	; registre 2	
		LDA #02				; 2	registre 2
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$07			; 2	Set fct "Set PSG Reg #"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)

OFFR2
.OFFR2	LDA $1F70			; 4
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$06			; 2	Set fct "Write DATA"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)
		INC .OFFR2+1		; 6
		BNE .sr3b			; 2/3
		INC .OFFR2+2		; 6
		JMP .sr3			; 3

.sr3b	INC Temp			; 5
		LDA Temp			; 3

.sr3	; registre 3	
		LDA #03				; 2	registre 3
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$07			; 2	Set fct "Set PSG Reg #"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)

OFFR3
.OFFR3	LDA $2B28			; 4
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$06			; 2	Set fct "Write DATA"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)
		INC .OFFR3+1		; 6
		BNE .sr4b			; 2/3
		INC .OFFR3+2		; 6
		JMP .sr4			; 3

.sr4b	INC Temp			; 5
		LDA Temp			; 3

.sr4	; registre 4
		LDA #04				; 2	registre 4
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$07			; 2	Set fct "Set PSG Reg #"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)

OFFR4
.OFFR4	LDA $36E0			; 4
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$06			; 2	Set fct "Write DATA"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)
		INC .OFFR4+1		; 6
		BNE .sr5b			; 2/3
		INC .OFFR4+2		; 6
		JMP .sr5			; 3

.sr5b	INC Temp			; 5
		LDA Temp			; 3

.sr5	; registre 5
		LDA #05				; 2	registre 5
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$07			; 2	Set fct "Set PSG Reg #"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)

OFFR5
.OFFR5	LDA $4298			; 4
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$06			; 2	Set fct "Write DATA"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)
		INC .OFFR5+1		; 6
		BNE .sr6b			; 2/3
		INC .OFFR5+2		; 6
		JMP .sr6			; 3

.sr6b	INC Temp			; 5
		LDA Temp			; 3

.sr6	; registre 6
		LDA #06				; 2	registre 6
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$07			; 2	Set fct "Set PSG Reg #"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)

