		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)
		INC .OFFR6+1		; 6
		BNE .sr7b			; 2/3
		INC .OFFR6+2		; 6
		JMP .sr7			; 3

.sr7b	INC Temp			; 5
		LDA Temp			; 3

.sr7	; registre 7
		LDA #07				; 2	registre 0
		STA (OUT1),Y		; 6	ORA1 (data)
		LDA #$07			; 2	Set fct "Set PSG Reg #"
		STA (OUT2),Y		; 6	ORB1 (fct)
		LDA #$04			; 2	Set fct "Inactive"
		STA (OUT2),Y		; 6	ORB1 (fct)

OFFR7
