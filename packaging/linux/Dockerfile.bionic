# Dockerfile.bionic — the FROZEN POM2 Linux release toolchain.
#
# WHY THIS EXISTS: an AppImage never bundles glibc, so the oldest system it can
# run on is decided by the glibc of the machine that BUILT it. Building POM2 on
# ubuntu-latest stamps GLIBC_2.38 into the binary (measured, not guessed), which
# would refuse to start on Debian 12 (2.36), Ubuntu 22.04 (2.35), Linux Mint 21
# and Raspberry Pi OS bookworm. Building inside Ubuntu 18.04 (bionic, glibc 2.27)
# drops that floor to 2.27 and covers essentially every distro still in use.
#
# Bionic is EOL, though: its apt mirrors flip between archive.ubuntu.com and
# old-releases.ubuntu.com and suffer outages. Doing apt-get + source builds AT
# RELEASE TIME would make every release depend on that. So the whole toolchain is
# baked ONCE into a pinned image pushed to GHCR; the flaky steps run only when
# this image is (re)built, off the release critical path. A release then just
# `docker run`s it (see build_in_bionic.sh) and is reproducible by image digest.
#
# Every download is version-pinned AND checksum-verified: a mismatch is a hard
# failure, on purpose. That is what stops silent upstream drift — the class of
# problem that once flipped appimagetool's `continuous` tag to an ET_DYN runtime
# which AppImageLauncher rejects as "type -1".
#
# Build + push via .github/workflows/build-bionic-image.yml, then pin the digest
# it prints into release.yml.
#
# NOTE vs POM1's equivalent: POM2 bundles no cc65 (it has no in-app assembler),
# so the cc65 and python3.8 layers are deliberately absent.
FROM ubuntu:18.04

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

ARG CMAKE_VER=3.27.9
ARG CMAKE_SHA256=72b01478eeb312bf1a0136208957784fe55a7b587f8d9f9142a7fc9b0b9e9a28
ARG GLFW_VER=3.3.10
ARG GLFW_SHA256=4ff18a3377da465386374d8127e7b7349b685288cb8e17122f7e1179f73769d5
ARG APPIMAGETOOL_SHA256=b90f4a8b18967545fda78a445b27680a1642f1ef9488ced28b65398f2be7add2
ARG LINUXDEPLOY_SHA256=e87ee0815d109282fdda73e34c2361d64d02b0ffaea3674b18f1fd1f6a687dcf

# --- base tooling + X11/GL dev headers ---------------------------------------
# Retry archive.ubuntu.com first (it carries bionic again as of 2026-07); fall
# back to old-releases only if it truly gives up. This fragility now bites at
# image-build time only, never during a release.
RUN apt_update_retry() { local i; for i in 1 2 3 4; do apt-get update && return 0; echo "[apt] update attempt $i/4 failed; retrying in 15s" >&2; sleep 15; done; return 1; }; \
    if ! apt_update_retry; then \
        echo "[apt] archive.ubuntu.com unreachable — falling back to old-releases" >&2; \
        sed -i -e 's|http://archive.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
               -e 's|http://security.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
               /etc/apt/sources.list; \
        apt_update_retry; \
    fi; \
    apt-get install -y --no-install-recommends \
        ca-certificates gnupg wget curl git make pkg-config \
        file desktop-file-utils xz-utils zsync \
        build-essential software-properties-common \
        libgl1-mesa-dev \
        libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev libxext-dev

# --- g++-9 (bionic's default g++-7 has no usable <filesystem>, which POM2 uses
#     in ResourcePaths / DiskLibrary / Settings) --------------------------------
RUN add-apt-repository -y ppa:ubuntu-toolchain-r/test && apt-get update && \
    apt-get install -y --no-install-recommends gcc-9 g++-9 && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-9 90 \
                        --slave   /usr/bin/g++ g++ /usr/bin/g++-9 && \
    gcc --version

# --- modern CMake (bionic ships 3.10; POM2 needs >= 3.16) --------------------
RUN wget -qO /tmp/cmake.tar.gz \
        "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VER}/cmake-${CMAKE_VER}-linux-x86_64.tar.gz" && \
    echo "${CMAKE_SHA256}  /tmp/cmake.tar.gz" | sha256sum -c - && \
    mkdir -p /opt/cmake && tar --strip-components=1 -xzf /tmp/cmake.tar.gz -C /opt/cmake && \
    rm -f /tmp/cmake.tar.gz
ENV PATH="/opt/cmake/bin:${PATH}"

# --- GLFW 3.3 from source → /usr/local (bionic's libglfw3-dev is 3.2.1, and
#     POM2's find_package asks for 3.3) ---------------------------------------
RUN wget -qO /tmp/glfw.tar.gz \
        "https://github.com/glfw/glfw/archive/refs/tags/${GLFW_VER}.tar.gz" && \
    echo "${GLFW_SHA256}  /tmp/glfw.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/glfw.tar.gz -C /tmp && \
    cmake -S "/tmp/glfw-${GLFW_VER}" -B /tmp/glfw-build \
        -DGLFW_BUILD_EXAMPLES=OFF -DGLFW_BUILD_TESTS=OFF -DGLFW_BUILD_DOCS=OFF \
        -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build /tmp/glfw-build -j"$(nproc)" --target install && ldconfig && \
    rm -rf /tmp/glfw.tar.gz "/tmp/glfw-${GLFW_VER}" /tmp/glfw-build

# --- AppImage tooling, pre-extracted → /opt/appimage-tools -------------------
#     appimagetool from AppImageKit (the OLD repo) on purpose: its runtime is
#     ELF ET_EXEC, which AppImageLauncher accepts. The newer AppImage/appimagetool
#     ships a static-pie ET_DYN runtime that AppImageLauncher rejects as "type -1".
#     Extracted because CI runners have no FUSE; build_appimage.sh calls them
#     through their AppRun via POM2_APPIMAGE_TOOLS_DIR.
RUN mkdir -p /opt/appimage-tools && cd /opt/appimage-tools && \
    wget -q "https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage" -O linuxdeploy.AppImage && \
    echo "${LINUXDEPLOY_SHA256}  linuxdeploy.AppImage" | sha256sum -c - && \
    wget -q "https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage" -O appimagetool.AppImage && \
    echo "${APPIMAGETOOL_SHA256}  appimagetool.AppImage" | sha256sum -c - && \
    chmod +x ./*.AppImage && \
    ./linuxdeploy.AppImage  --appimage-extract >/dev/null && mv squashfs-root linuxdeploy.AppDir && \
    ./appimagetool.AppImage --appimage-extract >/dev/null && mv squashfs-root appimagetool.AppDir && \
    rm -f ./*.AppImage
ENV POM2_APPIMAGE_TOOLS_DIR=/opt/appimage-tools

WORKDIR /work
