@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@POM2_CORE_PACKAGE_NEEDS_THREADS@)
    find_dependency(Threads)
endif()

if(@POM2_CORE_PACKAGE_WITH_SLIRP@)
    find_dependency(PkgConfig)
    pkg_check_modules(SLIRP REQUIRED IMPORTED_TARGET slirp)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/pom2_coreTargets.cmake")
check_required_components(pom2_core)
